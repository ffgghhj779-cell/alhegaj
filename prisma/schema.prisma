// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  Sale
  Rent
}

enum ServiceRequestStatus {
  New
  InProgress
  Completed
  Cancelled
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String
  price       Float
  status      PropertyStatus
  area        Float
  rooms       Int
  bathrooms   Int
  city        String         @default("الرياض")
  address     String         @default("")
  lat         Float
  lng         Float
  imageUrl    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ServiceRequest {
  id           String               @id @default(cuid())
  serviceSlug  String
  serviceTitle String
  name         String
  phone        String
  city         String               @default("")
  notes        String               @default("")
  details      Json
  status       ServiceRequestStatus @default(New)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([serviceSlug])
}

model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  phone     String
  interest  String
  message   String
  source    String               @default("contact")
  sourceRef String               @default("")
  status    ServiceRequestStatus @default(New)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}
